# Puerto del servidor
PORT=4000
# Origen permitido para CORS (frontend dev)
CORS_ORIGIN=http://localhost:5173

# Ollama (inferencia local, sin tokens)
# Cambia si tu servicio Ollama corre en otra IP/puerto
OLLAMA_HOST=http://localhost:11434

# Modelo de fallback (si el elegido no está disponible)
OLLAMA_FALLBACK_MODEL=qwen2.5:14b-instruct

# Router (modelo por defecto para consultas generales)
# Sugerido: qwen2.5:7b-instruct para mejor velocidad
ROUTER_GENERAL_MODEL=qwen2.5:7b-instruct

# Opciones de generación (ajustan velocidad/calidad)
# num_predict limita la cantidad de tokens de salida
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0.6
OLLAMA_TOP_P=0.9
# Mantener el modelo cargado para reducir latencia tras el warmup
OLLAMA_KEEP_ALIVE=5m
