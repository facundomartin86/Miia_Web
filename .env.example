# Copia este archivo a .env.local y ajústalo según tu entorno
# URL base del API del backend (opcional). Si no se define, el frontend usa auth de prueba (admin/miia2025)
VITE_API_URL=http://localhost:4000

# Versión a mostrar en la UI (Sidebar). Opcional; por defecto "v1.0.0"
VITE_APP_VERSION=v1.0.0
